# Copy to .env and adjust. Defaults shown are deliberately conservative.

WHISPER_MODEL=large-v3
ALLOW_MODEL_OVERRIDE=false
TERMS_FILE=

# --- Cloudflare Turnstile (captcha) ---
# Get keys at dash.cloudflare.com -> Turnstile. The secret stays here; the site
# key goes into the React component. Leaving this empty DISABLES the captcha.
TURNSTILE_SECRET=

# --- Per-request limits ---
MAX_UPLOAD_MB=100
MAX_DURATION_SEC=600

# --- Per-client limits (best effort: defeated by IP rotation) ---
RATE_LIMIT_PER_HOUR=3
RATE_LIMIT_PER_DAY=10

# --- Global limits: the hard ceiling on what the machine can be made to do,
# regardless of how many clients ask. Persisted to budget.json so restarting
# the server does not reset them.
MAX_QUEUE_DEPTH=5
GLOBAL_JOBS_PER_HOUR=20
GLOBAL_JOBS_PER_DAY=100
GLOBAL_AUDIO_MINUTES_PER_DAY=180
MAX_DISK_MB=1000
JOB_TIMEOUT_SEC=1800
JOB_TTL_SEC=3600
BUDGET_FILE=

# Set this in production. "*" lets any site spend your GPU budget.
ALLOWED_ORIGINS=https://your-site.com,http://localhost:3000

# Optional shared secret clients must send as X-API-Key.
API_KEY=

HOST=0.0.0.0
PORT=8000
LIMIT_CONCURRENCY=50
