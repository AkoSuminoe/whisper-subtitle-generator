# Copy to .env and adjust. Defaults shown are deliberately conservative.

WHISPER_MODEL=large-v3
ALLOW_MODEL_OVERRIDE=false
TERMS_FILE=

# --- Cloudflare Turnstile (captcha) ---
# Get keys at dash.cloudflare.com -> Turnstile. The secret stays here; the site
# key goes into the web front end. Leaving this empty DISABLES the captcha.
#
# One Turnstile site can cover several hostnames, so berktan.dev and
# whisper.berktan.dev can share a key pair. If they do, this secret must match
# TURNSTILE_SECRET in the site's own environment, and the front end reports a
# clear error when this server requires a captcha the page has no key for.
TURNSTILE_SECRET=

# --- Per-request limits ---
MAX_UPLOAD_MB=100
MAX_DURATION_SEC=600

# --- Per-client limits (best effort: defeated by IP rotation) ---
RATE_LIMIT_PER_HOUR=3
RATE_LIMIT_PER_DAY=10

# --- Global limits: the hard ceiling on what the machine can be made to do,
# regardless of how many clients ask. Persisted to budget.json so restarting
# the server does not reset them.
MAX_QUEUE_DEPTH=5
GLOBAL_JOBS_PER_HOUR=20
GLOBAL_JOBS_PER_DAY=100
GLOBAL_AUDIO_MINUTES_PER_DAY=180
MAX_DISK_MB=1000
JOB_TIMEOUT_SEC=1800
JOB_TTL_SEC=3600
BUDGET_FILE=

# Set this in production. "*" lets any site spend your GPU budget.
#
# In the deployed setup this is belt and braces rather than the main control:
# the Cloudflare Tunnel routes whisper.berktan.dev/api/* here and everything
# else to the Next site, so the browser is same-origin with this API and no
# CORS preflight happens at all. Keep the value narrow anyway, because the
# tunnel config is one edit away from changing.
ALLOWED_ORIGINS=https://whisper.berktan.dev,http://localhost:3000

# Optional shared secret clients must send as X-API-Key.
API_KEY=

# 127.0.0.1, not 0.0.0.0. The tunnel connects from this same machine, so
# binding every interface only exposes the server to the local network for no
# benefit. It is also what makes trusting cf-connecting-ip in _client_key()
# sound: if the port were reachable directly, anyone could set that header and
# rotate through fake values to defeat the per-client rate limits.
HOST=127.0.0.1
PORT=8000
LIMIT_CONCURRENCY=50
