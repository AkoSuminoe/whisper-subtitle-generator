# Copy to .env and adjust. All values are optional; defaults shown.

# Model served to every request. large-v3 is the most accurate; large-v3-turbo
# is roughly 5-8x faster with slightly lower quality on non-English audio.
WHISPER_MODEL=large-v3

# Let clients pick the model instead of always using WHISPER_MODEL.
ALLOW_MODEL_OVERRIDE=false

# Abuse limits. This endpoint spends real GPU time, so keep these tight.
MAX_UPLOAD_MB=200
MAX_DURATION_SEC=900
RATE_LIMIT_PER_HOUR=5

# How long a finished job (and its SRT) stays retrievable.
JOB_TTL_SEC=3600

# Comma-separated site origins allowed to call the API. Set this in production;
# "*" is convenient locally but lets any site spend your GPU budget.
ALLOWED_ORIGINS=https://your-site.com,http://localhost:3000

# Leave empty for an open endpoint, or set a secret that clients must send
# in the X-API-Key header.
API_KEY=

# Custom dictionary for the server. Defaults to terms.json in the repo root.
TERMS_FILE=

HOST=0.0.0.0
PORT=8000
